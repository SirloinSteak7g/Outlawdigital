{{- $siteURL := .Site.Params.siteURL -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Site.AllPages -}}
    {{- if or (eq .Kind "home") (eq .Kind "section") (eq .Kind "page") -}}
  <url>
    <loc>{{ printf "%s%s" $siteURL .RelPermalink }}</loc>
    <changefreq>monthly</changefreq>
    <priority>{{ if .IsHome }}1.0{{ else if .IsSection }}0.8{{ else }}0.6{{ end }}</priority>
  </url>
    {{- end -}}
  {{- end -}}
</urlset>